#!/usr/bin/env python3
"""myzk-agents — live "what is each agent doing" board for the Omarchy notch.

State lives in ~/.local/state/myzk-agents/summary.json, which the
myzk.notch overlay watches. Writers:

  myzk-agents claude-hook          Claude Code hook (reads hook JSON on stdin)
  myzk-agents mcp                  stdio MCP server; Grok Bots call report_status
  myzk-agents set AGENT ID STATE [--name N] [--task T] [--detail D]
  myzk-agents rm AGENT ID
  myzk-agents ask PROMPT [--resume SID | --id NEW_UUID] [--agent claude|codex]   run an agent headless (notch input)
  myzk-agents detect               JSON: which coding agents are installed on this machine
  myzk-agents route PROMPT         dry run of the router's free rules (tier + signals)
  myzk-agents router-stats         how asks were routed, failures and escalations per tier

Readers:
  myzk-agents list                 one-shot table
  myzk-agents watch                live table in the terminal

Nothing here connects agents to each other; it only records what each one
says it is doing.
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
import uuid

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "myzk-agents"
)
SUMMARY = os.path.join(STATE_DIR, "summary.json")
CONFIG = os.environ.get("AGENT_NOTCH_CONFIG") or os.path.expanduser(
    "~/.config/agent-notch/config.json")
I18N = os.environ.get("AGENT_NOTCH_I18N") or next(
    (p for p in (os.path.expanduser("~/.config/agent-notch/i18n.json"),
                 os.path.expanduser("~/.config/omarchy/plugins/myzk.notch/i18n.json"))
     if os.path.exists(p)),
    os.path.expanduser("~/.config/omarchy/plugins/myzk.notch/i18n.json"))
LOCK = os.path.join(STATE_DIR, ".lock")
CHATS = os.path.join(STATE_DIR, "chats")

STATES = ("idle", "thinking", "working", "upload", "restart", "waiting", "done", "error")
ACTIVE = ("thinking", "working", "upload", "restart", "waiting")

# Claude sessions: finished or idle entries fade out after this; anything
# silent for MAX_AGE is assumed dead (crashed session). Grok Bots are a fixed
# roster, so they stay (asleep) until they report "off" or you `rm` them.
IDLE_TTL = 2 * 3600
MAX_AGE = 8 * 3600


# --------------------------------------------------------------- config

def _read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


_CFG = None
_STRINGS = None


def cfg(key, default=None):
    global _CFG
    if _CFG is None:
        _CFG = _read_json(CONFIG)
    v = _CFG.get(key)
    return default if v is None else v


def tr(key, **kw):
    """UI text: config "strings" override, then the language, then English."""
    global _STRINGS
    if _STRINGS is None:
        i18n = _read_json(I18N)
        _STRINGS = {**i18n.get("en", {}), **i18n.get(cfg("language", "en"), {}),
                    **cfg("strings", {})}
    text = str(_STRINGS.get(key, key)).replace("{name}", cfg("assistantName", "Claude"))
    for k, v in kw.items():
        text = text.replace("{" + k + "}", str(v))
    return text


# ---------------------------------------------------------------- store

def _load():
    try:
        with open(SUMMARY) as f:
            return json.load(f).get("agents", {})
    except (OSError, ValueError):
        return {}


def _ttl(a):
    if a.get("state") in ACTIVE:
        return MAX_AGE
    # Chats started from the notch/client are conversations you come back to: keep them for days.
    if a.get("source") == "notch":
        return float(cfg("chatTTLDays", 7)) * 86400
    return IDLE_TTL


def _chat_file(key):
    return os.path.join(CHATS, key.replace(":", "-").replace("/", "_") + ".json")


def _drop_chat(key):
    try:
        os.remove(_chat_file(key))
    except OSError:
        pass


def append_turn(agent, ident, prompt, answer, failed=False):
    """Full transcript of a notch chat, one file per chat (summary.json only keeps the last turn)."""
    os.makedirs(CHATS, exist_ok=True)
    path = _chat_file(f"{agent}:{ident}")
    turns = _read_json(path) if os.path.exists(path) else []
    turns = turns if isinstance(turns, list) else []
    turns.append({"q": prompt, "a": answer, "t": time.time(), "error": bool(failed)})
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(turns[-200:], f, ensure_ascii=False)
    os.replace(tmp, path)


def _save(agents):
    now = time.time()
    kept = {k: a for k, a in agents.items()
            if a.get("agent") == "grok" or now - a.get("updated", 0) < _ttl(a)}
    for k in agents.keys() - kept.keys():
        _drop_chat(k)
    agents = kept
    tmp = SUMMARY + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"updated": now, "agents": agents}, f, ensure_ascii=False)
    os.replace(tmp, SUMMARY)


def update(agent, ident, state=None, remove=False, **fields):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        agents = _load()
        key = f"{agent}:{ident}"
        if remove:
            agents.pop(key, None)
            _drop_chat(key)
        else:
            now = time.time()
            entry = agents.get(key, {"agent": agent, "id": ident, "since": now})
            if state and state != entry.get("state"):
                entry["since"] = now
                entry["state"] = state
            for k, v in fields.items():
                if v is not None:
                    entry[k] = v
            entry["updated"] = now
            agents[key] = entry
        _save(agents)


# ------------------------------------------------------- model discovery

_COST_ORDER = ("haiku", "sonnet", "opus", "fable")   # cheapest first, for Claude families


def _claude_models():
    """Aliases the installed Claude Code advertises in `--model` help, plus any family seen in
    recent session transcripts (so a new family shows up without touching this file)."""
    found = {"haiku", "sonnet", "opus"}
    try:
        out = subprocess.run([_claude_bin(), "--help"], capture_output=True, text=True, timeout=15).stdout
        block = re.search(r"--model <model>(.*?)(?=\n\s+--\w)", out, re.S)
        if block:
            found |= set(re.findall(r"'([a-z][a-z0-9.-]*)'", block.group(1)))
    except Exception:
        pass
    root = os.path.expanduser("~/.claude/projects")
    try:
        recent = sorted((os.path.join(d, f) for d, _, fs in os.walk(root) for f in fs if f.endswith(".jsonl")),
                        key=os.path.getmtime, reverse=True)[:15]
        for path in recent:
            with open(path, "rb") as f:
                f.seek(max(0, os.path.getsize(path) - 100_000))
                for m in re.findall(r'"model":"claude-([a-z]+)-', f.read().decode("utf-8", "ignore")):
                    found.add(m)
    except OSError:
        pass
    known = [m for m in _COST_ORDER if m in found]
    return known + sorted(found - set(known))


def _codex_models():
    """Models Codex itself reports for this account (its own models cache), in its priority order."""
    try:
        with open(os.path.expanduser("~/.codex/models_cache.json")) as f:
            rows = json.load(f).get("models", [])
    except (OSError, ValueError):
        return []
    rows = [r for r in rows if r.get("visibility", "list") == "list" and r.get("slug")]
    return [r["slug"] for r in sorted(rows, key=lambda r: r.get("priority", 99))]


def discover_models(agent):
    """Models you can pick for an agent: scanned automatically for Claude and Codex, or listed by
    hand in config.json under "models": {"agent": ["a", "b"]} for any other CLI."""
    manual = (cfg("models", {}) or {}).get(agent)
    if isinstance(manual, list) and manual:
        return [str(m) for m in manual]
    if agent == "claude":
        return _claude_models()
    if agent == "codex":
        return _codex_models()
    return []


# ---------------------------------------------------------- claude hook

def _short(s, n=70):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def _tool_detail(tool, inp):
    inp = inp or {}
    if tool == "Bash":
        arg = inp.get("description") or inp.get("command", "")
    elif tool in ("Edit", "Write", "Read", "NotebookEdit"):
        arg = os.path.basename(inp.get("file_path") or inp.get("notebook_path") or "")
    elif tool in ("Grep", "Glob"):
        arg = inp.get("pattern", "")
    elif tool == "WebFetch":
        arg = inp.get("url", "")
    elif tool == "WebSearch":
        arg = inp.get("query", "")
    elif tool == "Agent":
        arg = inp.get("description", "")
    elif tool == "Skill":
        arg = inp.get("skill", "")
    else:
        arg = ""
    if tool.startswith("mcp__"):
        parts = tool.split("__")
        return _short(f"{parts[1]}: {parts[-1]}")
    verb = tr("tool." + tool)
    verb = tool if verb == "tool." + tool else verb
    return _short(f"{verb} {arg}".strip())


# Commands that send stuff somewhere: the face switches to its "upload" look.
UPLOAD_RE = re.compile(
    r"\b(git\s+push|gh\s+(release\s+upload|pr\s+create|gist\s+create)|scp|rsync|rclone\s+(copy|sync)"
    r"|npm\s+publish|cargo\s+publish|twine\s+upload|eas\s+(submit|update)|docker\s+push)\b"
    r"|curl\b.*\s(-T|-F|--upload-file|--form)\b")


def _is_upload(tool, inp):
    inp = inp or {}
    if tool == "Bash":
        return bool(UPLOAD_RE.search(inp.get("command", "")))
    return tool.startswith("mcp__") and re.search(r"upload|create_file|update_file|share", tool) is not None


def _model_family(model):
    """claude-opus-5-5 -> "opus", "haiku" -> "haiku"; unknown ids are shown as-is."""
    m = re.search(r"haiku|sonnet|opus|fable", str(model).lower())
    return m.group(0) if m else str(model or "")


def _transcript_model(path):
    """Model of the last assistant turn, read from the tail of the session transcript."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 200_000))
            lines = f.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return ""
    for l in reversed(lines):
        if '"model"' in l:
            try:
                m = (json.loads(l).get("message") or {}).get("model")
            except ValueError:
                continue
            if m and not m.startswith("<"):
                return _model_family(m)
    return ""


def _runner_alive(entry):
    pid = entry.get("runner") if entry.get("source") == "notch" else None
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def claude_hook():
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    sid = ev.get("session_id") or "?"
    cwd = ev.get("cwd") or os.getcwd()
    name = os.path.basename(cwd.rstrip("/")) or cwd
    kind = ev.get("hook_event_name", "")
    common = {"name": name, "cwd": cwd}
    # Show the real model for every session (typed in a terminal or asked from the notch).
    model = _model_family(ev["model"]) if ev.get("model") else (
        _transcript_model(ev["transcript_path"])
        if kind in ("UserPromptSubmit", "Stop") and ev.get("transcript_path") else "")
    if model:
        common["model"] = model

    if kind == "SessionEnd":
        # Notch tasks outlive their process: the ask runner writes the answer.
        if _load().get(f"claude:{sid}", {}).get("source") != "notch":
            update("claude", sid, remove=True)
    elif kind == "SessionStart":
        # /clear, compaction and resume play the "restart" look for a moment.
        if ev.get("source") in ("clear", "compact", "resume"):
            update("claude", sid, "restart", detail=tr("restart." + ev["source"]), **common)
        else:
            update("claude", sid, "idle", detail=tr("sessionOpen"), **common)
    elif kind == "PreCompact":
        update("claude", sid, "restart", detail=tr("restart.compact"), **common)
    elif kind == "UserPromptSubmit":
        # Pasted blocks arrive wrapped in <pasted_content id=…> tags; show the text.
        prompt = re.sub(r"</?pasted_content[^>]*>", " ", ev.get("prompt", ""))
        prompt = _short(prompt, 90) or "…"
        update("claude", sid, "thinking", task=prompt, detail=tr("thinking"), **common)
    elif kind == "PreToolUse":
        tool, inp = ev.get("tool_name", ""), ev.get("tool_input")
        update("claude", sid, "upload" if _is_upload(tool, inp) else "working",
               detail=_tool_detail(tool, inp), **common)
    elif kind == "PostToolUse":
        update("claude", sid, "thinking", detail=tr("thinking"), **common)
    elif kind in ("Notification", "PermissionRequest"):
        msg = ev.get("message") or tr("waitingPermission")
        update("claude", sid, "waiting", detail=_short(msg), **common)
    elif kind == "Stop":
        # Notch runs are finished by their ask runner, together with the answer (unless the
        # chat was later continued in a terminal and no runner is alive).
        if not _runner_alive(_load().get(f"claude:{sid}", {})):
            update("claude", sid, "done", detail=tr("readyNext"), **common)


# ------------------------------------------------------------ mcp server

MCP_TOOLS = [{
    "name": "report_status",
    "description": (
        "Report what you are doing right now to the user's desktop status bar. "
        "Call it when you start a task, at each meaningful step, when you need "
        "the user, and when you finish or fail. It only displays status; it "
        "never changes anything else."
    ),
    "inputSchema": {
        "type": "object",
        "properties": {
            "bot": {"type": "string", "description": "Your bot's name, always the same."},
            "state": {
                "type": "string",
                "enum": ["working", "upload", "restart", "waiting", "done", "error", "idle", "off"],
                "description": "working = busy; upload = sending/publishing files; restart = "
                               "restarting or resetting; waiting = needs the user; done/error = "
                               "finished; idle = nothing to do; off = remove from the bar.",
            },
            "task": {"type": "string", "description": "The overall task, short."},
            "detail": {"type": "string", "description": "The current step, short."},
        },
        "required": ["bot", "state"],
    },
}]


def _mcp_call(args):
    bot = _short(args.get("bot") or "grok", 40)
    state = args.get("state", "working")
    if state == "off":
        update("grok", bot, remove=True)
        return "Removed from status bar."
    if state not in STATES:
        state = "working"
    update("grok", bot, state, name=bot,
           task=_short(args["task"], 90) if args.get("task") else None,
           detail=_short(args["detail"]) if args.get("detail") else None)
    return f"Status shown: {bot} → {state}."


def mcp_server():
    def send(msg):
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except ValueError:
            continue
        method, rid = req.get("method"), req.get("id")
        if rid is None:
            continue  # notifications (initialized, cancelled, …)
        if method == "initialize":
            result = {
                "protocolVersion": req.get("params", {}).get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "myzk-agents", "version": "1.0.0"},
            }
        elif method == "tools/list":
            result = {"tools": MCP_TOOLS}
        elif method == "tools/call":
            p = req.get("params", {})
            if p.get("name") != "report_status":
                send({"jsonrpc": "2.0", "id": rid,
                      "error": {"code": -32602, "message": "Unknown tool"}})
                continue
            try:
                text, err = _mcp_call(p.get("arguments") or {}), False
            except Exception as e:  # never kill the server over one bad call
                text, err = f"Failed: {e}", True
            result = {"content": [{"type": "text", "text": text}], "isError": err}
        elif method == "ping":
            result = {}
        else:
            send({"jsonrpc": "2.0", "id": rid,
                  "error": {"code": -32601, "message": f"Method not found: {method}"}})
            continue
        send({"jsonrpc": "2.0", "id": rid, "result": result})


# ------------------------------------------------------------------ ask

def _claude_bin():
    cmd = os.path.expanduser(cfg("claudeCommand", "claude"))
    return shutil.which(cmd) or shutil.which("claude") or os.path.expanduser(
        "~/.local/share/mise/installs/claude/latest/claude")


_ROUTER_PROMPT = (
    "Classify the difficulty of the user's task for an AI coding assistant. Reply with ONE word:\n"
    "simple  = quick question, lookup, small edit, rename, summary, status check\n"
    "medium  = typical feature, bug fix, multi-file change, explanation needing code reading\n"
    "complex = architecture, large refactor, hard debugging, security review, deep multi-step work\n"
    "Task:\n")


TIERS = ("simple", "medium", "complex")
ROUTER_LOG = os.path.join(STATE_DIR, "router.jsonl")
ROUTER_CACHE = os.path.join(STATE_DIR, "router-cache.json")

# Stage 1 signals (es + en). Override or extend them in config.json under
# modelRouter.words: {"simple": [...], "medium": [...], "complex": [...]}.
ROUTER_WORDS = {
    "simple": [r"\bhola\b", r"\bhello\b", r"\bgracias\b", r"\bthanks\b", r"\brenombra", r"\brename",
               r"\bresume\b", r"\bresumen\b", r"\bsummar", r"\btraduc", r"\btranslat", r"\btypo\b",
               r"\bformatea", r"\bformat\b", r"qu[eé] hora", r"\bcu[aá]l es\b", r"\bwhat is\b",
               r"\bmuestra\b", r"\bshow me\b", r"\blista\b", r"\blist\b", r"\bestado\b", r"\bstatus\b",
               r"\bcuántos?\b", r"\bhow many\b", r"\bconvierte\b", r"\bconvert\b"],
    "medium": [r"\barregla", r"\bfix\b", r"\bbug\b", r"\berror\b", r"\bagrega", r"\ba[ñn]ade",
               r"\badd\b", r"\bimplement", r"\btest", r"\bprueba", r"\bexplica", r"\bexplain",
               r"\bscript\b", r"\bfunci[oó]n\b", r"\bfunction\b", r"\bendpoint", r"\bcomponente?\b"],
    "complex": [r"\brefactor", r"\barquitectura", r"\barchitect", r"\bmigra", r"\bseguridad\b",
                r"\bsecurity\b", r"\baudit", r"\bvulnerab", r"\bdepura", r"\bdebug", r"\bpor qu[eé] falla",
                r"\bwhy (does|is) .* fail", r"\brace condition", r"\bdeadlock", r"\brendimiento\b",
                r"\bperformance\b", r"\boptimiz", r"\bdiseñ[ao]", r"\bdesign\b", r"\bdesde cero\b",
                r"\bfrom scratch\b", r"\btodo el (proyecto|repo)", r"\bwhole (project|repo|codebase)",
                r"\bconcurren", r"\bescal(a|ar)bilidad", r"\bscalab"],
}
_PATH_RE = re.compile(r"(?:~|/|\./)[\w.\-]+(?:/[\w.\-]+)+|\b[\w\-]+\.(?:py|js|ts|tsx|qml|swift|kt|go|rs|java|c|cpp|h|sql|json|ya?ml|md)\b")
_STEP_RE = re.compile(r"(?m)^\s*(?:\d+[.)]|[-*•])\s+")


def _router_cfg():
    r = dict(cfg("modelRouter", {}) or {})
    words = {k: list(v) for k, v in ROUTER_WORDS.items()}
    for k, extra in (r.get("words") or {}).items():
        if k in words and isinstance(extra, list):
            words[k] += extra
    r["_words"] = words
    return r


def classify_rules(prompt, r=None):
    """Stage 1, free: keyword hits + shape of the prompt. Returns (tier or None, signals).
    None means "not sure" and the request goes on to the next stage."""
    r = r or _router_cfg()
    text = prompt.lower()
    body = re.sub(r"\[attached image: [^\]]+\]", "", text)
    hits = {k: sum(1 for w in ws if re.search(w, body)) for k, ws in r["_words"].items()}
    paths = len(set(_PATH_RE.findall(body)))
    steps = len(_STEP_RE.findall(prompt))
    n = len(body.strip())
    images = text.count("[attached image:")
    sig = {"chars": n, "paths": paths, "steps": steps, "images": images, **{"w_" + k: v for k, v in hits.items()}}
    # Size and structure push towards harder tiers on their own.
    heavy = (n > int(r.get("longChars", 1500))) + (paths >= 4) + (steps >= 4)
    if hits["complex"] >= 2 or (hits["complex"] and (heavy or n > 600)) or heavy >= 2:
        return "complex", sig
    if n < int(r.get("minChars", 40)) and not hits["complex"] and not hits["medium"] and not images:
        return "simple", dict(sig, short=True)
    if hits["simple"] and not hits["medium"] and not hits["complex"] and n < 300 and not heavy:
        return "simple", sig
    if hits["medium"] and not hits["complex"] and not hits["simple"] and not heavy and n < 1200:
        return "medium", sig
    return None, sig


def _cache_key(prompt):
    import hashlib
    norm = re.sub(r"\s+", " ", re.sub(r"\[attached image: [^\]]+\]", "[img]", prompt.lower())).strip()
    return hashlib.sha1(norm.encode()).hexdigest()


def _cache_get(prompt, ttl):
    if ttl <= 0:
        return None
    c = _read_json(ROUTER_CACHE) if os.path.exists(ROUTER_CACHE) else {}
    hit = (c or {}).get(_cache_key(prompt))
    return hit["tier"] if hit and time.time() - hit.get("t", 0) < ttl and hit.get("tier") in TIERS else None


def _cache_put(prompt, tier, ttl):
    if ttl <= 0:
        return
    try:
        c = _read_json(ROUTER_CACHE) if os.path.exists(ROUTER_CACHE) else {}
        c = {k: v for k, v in (c or {}).items() if time.time() - v.get("t", 0) < ttl}
        c[_cache_key(prompt)] = {"tier": tier, "t": time.time()}
        if len(c) > 500:
            c = dict(sorted(c.items(), key=lambda kv: kv[1]["t"])[-500:])
        tmp = ROUTER_CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(c, f)
        os.replace(tmp, ROUTER_CACHE)
    except OSError:
        pass


def _classify_llm(prompt, r):
    """Stage 3: a small model labels the task. Returns a tier or None."""
    try:
        out = subprocess.run(
            [_claude_bin(), "-p", _ROUTER_PROMPT + prompt[:4000], "--model", r.get("router", "haiku"),
             "--tools", "", "--system-prompt", "You are a task classifier. Output one word only.",
             "--disable-slash-commands", "--no-session-persistence"],
            capture_output=True, text=True, timeout=int(r.get("timeout", 30)))
        word = re.search(r"simple|medium|complex", out.stdout.lower())
        return word.group(0) if word else None
    except Exception:
        return None


def route_model(prompt):
    """Decision tree for the model of a new ask:
      1. rules      free heuristics (keywords, length, paths, steps, images)
      2. cache      same prompt seen recently → same tier, no call
      3. auto       Haiku classifies only what the rules weren't sure about
      4. fallback   the default tier when the classifier fails
    Returns (model alias or None, how, tier, signals); how is rules|short|cache|auto|fallback|off."""
    r = _router_cfg()
    if not r.get("enabled", True):
        return None, "off", None, {}
    tiers = {"simple": r.get("simple", "haiku"), "medium": r.get("medium", "sonnet"),
             "complex": r.get("complex", "opus")}
    tier, sig = classify_rules(prompt, r) if r.get("rules", True) else (None, {})
    if tier:
        return tiers[tier], ("short" if sig.get("short") else "rules"), tier, sig
    ttl = float(r.get("cacheTTL", 86400))
    tier = _cache_get(prompt, ttl)
    if tier:
        return tiers[tier], "cache", tier, sig
    tier = _classify_llm(prompt, r)
    if tier:
        _cache_put(prompt, tier, ttl)
        return tiers[tier], "auto", tier, sig
    tier = r.get("fallback", "medium")
    return tiers.get(tier), "fallback", tier, sig


def next_tier(tier):
    """Escalation ladder: simple → medium → complex → None."""
    i = TIERS.index(tier) if tier in TIERS else len(TIERS) - 1
    return TIERS[i + 1] if i + 1 < len(TIERS) else None


def log_route(**row):
    """One line per routed ask, so the rules can be tuned with real data (`router-stats`)."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(ROUTER_LOG, "a") as f:
            f.write(json.dumps(dict(row, t=round(time.time(), 1)), ensure_ascii=False) + "\n")
    except OSError:
        pass


def router_stats():
    rows = []
    try:
        with open(ROUTER_LOG) as f:
            rows = [json.loads(l) for l in f if l.strip()]
    except (OSError, ValueError):
        pass
    if not rows:
        return "No routed asks yet."
    from collections import Counter
    by_how = Counter(r.get("how") for r in rows)
    by_tier = Counter(r.get("tier") for r in rows)
    lines = [f"{len(rows)} routed asks",
             "stage:  " + "  ".join(f"{k} {v}" for k, v in by_how.most_common()),
             "tier:   " + "  ".join(f"{k} {v}" for k, v in by_tier.most_common())]
    # Per starting tier: escalations out of "simple" are the rules' false negatives.
    for t in TIERS:
        sub = [r for r in rows if (r.get("start") or r.get("tier")) == t]
        if sub:
            fail = sum(1 for r in sub if r.get("failed"))
            esc = sum(1 for r in sub if r.get("escalated"))
            secs = sum(r.get("secs", 0) for r in sub) / len(sub)
            lines.append(f"  {t:8s} failed {fail}/{len(sub)}  escalated {esc}  avg {secs:.0f}s")
    return "\n".join(lines) + "\n"


def ask(prompt, resume=None, new_id=None, agent="claude", model=None):
    if agent == "codex":
        return ask_codex(prompt, resume, new_id, model)
    if agent != "claude":
        return ask_generic(agent, prompt, resume, new_id)
    sid = resume or new_id or str(uuid.uuid4())
    cwd = os.path.expanduser(os.environ.get("MYZK_NOTCH_CWD", "~"))
    session = ((_load().get(f"claude:{sid}") or {}).get("session") or sid) if resume else sid
    update("claude", sid, "thinking", name=_short(prompt, 22), cwd=cwd, source="notch",
           task=_short(prompt, 90), detail=tr("thinking"), answer="")

    # Detach twice so the notch never waits on (or kills) the run.
    if os.fork():
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    update("claude", sid, runner=os.getpid())

    base = [_claude_bin(), "-p", prompt, "--output-format", "json",
            "--permission-mode", cfg("permissionMode", "auto"),
            "--append-system-prompt", cfg("systemPrompt", "") or tr("systemPrompt")]
    how, tier, sig, t0 = "manual" if model else "keep", None, {}, time.time()
    start = None
    if model:  # chosen by the user in the notch: bypass the router
        update("claude", sid, model=model, route="manual")
    elif not resume:  # follow-ups keep the model (and prompt cache) of the session
        update("claude", sid, detail=tr("routing"))
        model, how, tier, sig = route_model(prompt)
        start = tier
        if model:
            update("claude", sid, model=model, route=how, detail=tr("thinking"))
    r = _router_cfg()
    log = os.path.join(STATE_DIR, "ask.log")
    escalated, run_id = [], (session if resume else sid)

    def run(args):
        out = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=3600)
        # mise may print a banner first; the result is the last JSON line.
        line = next((l for l in reversed(out.stdout.splitlines()) if l.startswith("{")), "{}")
        data = json.loads(line)
        answer = str(data.get("result") or "").strip() or tr("noAnswer")
        # Drop "🔊 …" spoken-summary lines (for TTS hooks), not for the card.
        answer = "\n".join(l for l in answer.splitlines() if not l.startswith("🔊")).strip() or answer
        failed = bool(data.get("is_error")) or out.returncode != 0 or not data
        if failed:
            with open(log, "a") as f:
                f.write(f"--- {time.ctime()} rc={out.returncode}\n{out.stdout[-2000:]}\n{out.stderr[-2000:]}\n")
        return answer, failed, data.get("session_id")

    while True:
        args = base + (["--resume", session] if resume else ["--session-id", run_id, "-n", "Notch"])
        if model:
            args += ["--model", model]
        try:
            answer, failed, real = run(args)
            if real:  # resumed runs may fork a new id: the chat keeps its key, resume follows the real one
                session = real
        except Exception as e:  # timeout, missing binary…
            answer, failed = tr("couldNotComplete", error=e), True
        # Fallback: a routed new ask that failed climbs one tier and tries again, in a fresh session.
        up = next_tier(tier) if failed and not resume and how not in ("manual", "keep") \
            and r.get("escalate", True) and len(escalated) < int(r.get("maxEscalations", 2)) else None
        if not up or not (r.get(up) or {"medium": "sonnet", "complex": "opus"}.get(up)):
            break
        escalated.append(model)
        tier, model = up, r.get(up) or {"medium": "sonnet", "complex": "opus"}[up]
        if session != sid:
            update("claude", session, remove=True)
        run_id = session = str(uuid.uuid4())
        update("claude", sid, "working", model=model, route="escalated",
               detail=tr("escalating", model=model.capitalize()))
    if tier or how not in ("manual", "keep"):
        log_route(how=how, start=start, tier=tier, model=model, escalated=escalated, failed=failed,
                  secs=round(time.time() - t0, 1), **sig)
    first = next((l for l in answer.splitlines() if l.strip()), answer)
    first = re.sub(r"[*_`#>]+", "", first).strip()
    if session != sid:
        update("claude", session, remove=True)   # the hooks' copy of the forked session
    append_turn("claude", sid, prompt, answer, failed)
    update("claude", sid, "error" if failed else "done", source="notch", name=_short(prompt, 22),
           cwd=cwd, answer=answer[:8000], detail=_short(first.lstrip("#*- ")), session=session, runner=0)
    os._exit(0)


def _codex_bin():
    for d in _search_dirs():
        p = os.path.join(d, "codex")
        if os.access(p, os.X_OK) and not os.path.isdir(p):
            return p
    p = "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex"
    return p if os.access(p, os.X_OK) else None


def ask_codex(prompt, resume=None, new_id=None, model=None):
    """Same contract as ask(), through `codex exec`. The notch keeps its own id for the
    chat; Codex's real thread id is stored in the entry's "thread" field for follow-ups."""
    sid = resume or new_id or str(uuid.uuid4())
    cwd = os.path.expanduser(os.environ.get("MYZK_NOTCH_CWD", "~"))
    thread = (_load().get(f"codex:{sid}") or {}).get("thread") if resume else None
    label = "Codex · " + _short(prompt, 16)
    update("codex", sid, "thinking", name=label, cwd=cwd, source="notch",
           task=_short(prompt, 90), detail=tr("thinking"), answer="",
           **({"model": model, "route": "manual"} if model else {}))
    if os.fork():
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)

    log = os.path.join(STATE_DIR, "ask.log")
    outfile = os.path.join(STATE_DIR, f"codex-{sid}.txt")
    answer, failed, found = "", True, thread
    try:
        binary = _codex_bin()
        if not binary:
            raise RuntimeError("codex not found")
        try:
            os.remove(outfile)
        except OSError:
            pass
        args = [binary, "exec"] + (["resume", thread] if thread else [])
        if not thread:   # `-i` is greedy: images first, flags after, prompt via stdin ("-")
            for img in re.findall(r"\[attached image: ([^\]]+)\]", prompt):
                args += ["-i", img]
        if model:
            args += ["-m", model]
        args += ["--json", "--skip-git-repo-check", "-c", f'sandbox_mode="{cfg("codexSandbox", "workspace-write")}"',
                 "-o", outfile, "-"]
        out = subprocess.run(args, cwd=cwd, input=prompt, capture_output=True, text=True, timeout=3600)
        last_msg = ""
        for line in out.stdout.splitlines():
            if not line.startswith("{"):
                continue
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("type") == "thread.started" and ev.get("thread_id"):
                found = ev["thread_id"]
            item = ev.get("item") or {}
            if ev.get("type") == "item.completed" and item.get("type") == "agent_message":
                last_msg = item.get("text") or last_msg
        try:
            answer = open(outfile).read().strip() or last_msg.strip()
        except OSError:
            answer = last_msg.strip()
        failed = out.returncode != 0 or not answer
        if failed:
            with open(log, "a") as f:
                f.write(f"--- {time.ctime()} codex rc={out.returncode}\n{out.stdout[-2000:]}\n{out.stderr[-2000:]}\n")
            answer = answer or tr("noAnswer")
    except Exception as e:
        answer, failed = tr("couldNotComplete", error=e), True
    first = next((l for l in answer.splitlines() if l.strip()), answer)
    first = re.sub(r"[*_`#>]+", "", first).strip()
    append_turn("codex", sid, prompt, answer, failed)
    update("codex", sid, "error" if failed else "done", source="notch", name=label, cwd=cwd,
           answer=answer[:8000], detail=_short(first.lstrip("#*- ")), thread=found)
    os._exit(0)


# One-shot headless commands for other agent CLIs ({prompt} is replaced). Override or add
# any of them in config.json under "chatCommands": {"gemini": ["gemini", "-p", "{prompt}"]}.
# Claude and Codex have dedicated runners above; the rest are untested defaults.
HEADLESS = {
    "gemini":   ["gemini", "-p", "{prompt}"],
    "grok":     ["grok", "-p", "{prompt}"],
    "opencode": ["opencode", "run", "{prompt}"],
    "cursor":   ["cursor-agent", "-p", "{prompt}"],
    "qwen":     ["qwen", "-p", "{prompt}"],
    "amp":      ["amp", "-x", "{prompt}"],
    "goose":    ["goose", "run", "-t", "{prompt}"],
    "copilot":  ["copilot", "-p", "{prompt}"],
    "aider":    ["aider", "--message", "{prompt}", "--yes-always", "--no-pretty"],
}
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def _headless_cmd(agent):
    custom = (cfg("chatCommands", {}) or {}).get(agent)
    return custom if isinstance(custom, list) and custom else HEADLESS.get(agent)


def _find_bin(agent):
    row = next((r for r in KNOWN_AGENTS if r[0] == agent), None)
    if not row:
        return None
    for d in _search_dirs():
        for exe in row[2]:
            p = os.path.join(d, exe)
            if os.access(p, os.X_OK) and not os.path.isdir(p):
                return p
    return None


def ask_generic(agent, prompt, resume=None, new_id=None):
    """Chat with any other agent CLI one shot at a time. Follow-ups carry the earlier turns
    in the prompt, so they 'remember' even if the CLI has no session resume."""
    sid = resume or new_id or str(uuid.uuid4())
    cwd = os.path.expanduser(os.environ.get("MYZK_NOTCH_CWD", "~"))
    name = next((r[1] for r in KNOWN_AGENTS if r[0] == agent), agent)
    label = f"{name} · " + _short(prompt, 14)
    history = (_load().get(f"{agent}:{sid}") or {}).get("history") or [] if resume else []
    update(agent, sid, "thinking", name=label, cwd=cwd, source="notch",
           task=_short(prompt, 90), detail=tr("thinking"), answer="")
    if os.fork():
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)

    answer, failed = "", True
    try:
        template, binary = _headless_cmd(agent), _find_bin(agent)
        if not template or not binary:
            raise RuntimeError(f"{agent}: no headless command or binary found")
        full = prompt
        if history:
            full = "Conversation so far:\n" + "\n".join(f"User: {u}\nAssistant: {a}" for u, a in history[-6:]) \
                   + f"\n\nUser: {prompt}"
        args = [binary] + [a.replace("{prompt}", full) for a in template[1:]]
        out = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=3600, stdin=subprocess.DEVNULL)
        answer = ANSI_RE.sub("", out.stdout).strip()
        failed = out.returncode != 0 or not answer
        if failed:
            with open(os.path.join(STATE_DIR, "ask.log"), "a") as f:
                f.write(f"--- {time.ctime()} {agent} rc={out.returncode}\n{out.stdout[-2000:]}\n{out.stderr[-2000:]}\n")
            answer = answer or ANSI_RE.sub("", out.stderr).strip()[-600:] or tr("noAnswer")
    except Exception as e:
        answer, failed = tr("couldNotComplete", error=e), True
    first = next((l for l in answer.splitlines() if l.strip()), answer)
    first = re.sub(r"[*_`#>]+", "", first).strip()
    hist = (history + [[prompt[:1500], answer[:3000]]])[-6:] if not failed else history
    append_turn(agent, sid, prompt, answer, failed)
    update(agent, sid, "error" if failed else "done", source="notch", name=label, cwd=cwd,
           answer=answer[:8000], detail=_short(first.lstrip("#*- ")), history=hist)
    os._exit(0)


# ----------------------------------------------------------------- views

COLOR = {"idle": "90", "thinking": "36", "working": "32", "waiting": "33;1",
         "done": "34", "error": "31;1", "upload": "36;1", "restart": "35"}


def _ago(t):
    s = int(time.time() - t)
    return f"{s}s" if s < 60 else f"{s // 60}m" if s < 3600 else f"{s // 3600}h{s % 3600 // 60:02d}"


def render():
    agents = sorted(_load().values(),
                    key=lambda a: (a.get("state") not in ACTIVE, -a.get("updated", 0)))
    if not agents:
        return f"  {tr('cli.none')}\n"
    out = []
    for a in agents:
        st = a.get("state", "idle")
        label = {"claude": "✻ " + cfg("assistantName", "Claude"), "grok": "◆ " + cfg("grokName", "Grok")}
        head = f"{label.get(a['agent'], a['agent'])} · {a.get('name', a['id'])}"
        out.append(f"\033[1m{head}\033[0m  \033[{COLOR.get(st, '0')}m● "
                   f"{tr('state.' + st)}\033[0m  \033[90m{_ago(a.get('since', 0))}\033[0m")
        if a.get("task"):
            out.append(f"   {tr('cli.task')}: {a['task']}")
        if a.get("detail"):
            out.append(f"   {tr('cli.now')}: {a['detail']}")
        out.append("")
    return "\n".join(out)


def watch():
    try:
        while True:
            sys.stdout.write(f"\033[H\033[2J\033[1m{tr('cli.title')}\033[0m  "
                             f"\033[90m{time.strftime('%H:%M:%S')} · {tr('cli.quit')}\033[0m\n\n")
            sys.stdout.write(render())
            sys.stdout.flush()
            time.sleep(1)
    except KeyboardInterrupt:
        pass


# ---------------------------------------------------------- detect agents

# id, display name, executables, config dirs that show it has been used, macOS apps
KNOWN_AGENTS = [
    ("claude",   "Claude Code",        ["claude"],            ["~/.claude"],                          ["Claude.app"]),
    ("codex",    "Codex",              ["codex"],             ["~/.codex"],                           ["Codex.app", "ChatGPT.app/Contents/Resources/codex-cli/bin/codex"]),
    ("gemini",   "Gemini CLI",         ["gemini"],            ["~/.gemini"],                          []),
    ("grok",     "Grok",               ["grok"],              ["~/.grok"],                            []),
    ("opencode", "OpenCode",           ["opencode"],          ["~/.config/opencode", "~/.local/share/opencode"], []),
    ("cursor",   "Cursor Agent",       ["cursor-agent"],      ["~/.cursor"],                          ["Cursor.app"]),
    ("aider",    "Aider",              ["aider"],             ["~/.aider"],                           []),
    ("amp",      "Amp",                ["amp"],               ["~/.config/amp"],                      []),
    ("qwen",     "Qwen Code",          ["qwen"],              ["~/.qwen"],                            []),
    ("goose",    "Goose",              ["goose"],             ["~/.config/goose"],                    []),
    ("copilot",  "GitHub Copilot CLI", ["copilot"],           ["~/.copilot"],                         []),
]


def _search_dirs():
    import glob
    dirs = os.environ.get("PATH", "").split(os.pathsep)
    home = os.path.expanduser("~")
    dirs += [home + d for d in ("/.local/bin", "/.npm-global/bin", "/.bun/bin", "/.cargo/bin", "/.volta/bin",
                                "/.local/share/mise/shims", "/.deno/bin")]
    dirs += ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin"]
    dirs += glob.glob(home + "/.nvm/versions/node/*/bin")
    seen, out = set(), []
    for d in dirs:
        if d and d not in seen and os.path.isdir(d):
            seen.add(d)
            out.append(d)
    return out


def _version(path):
    try:
        r = subprocess.run([path, "--version"], capture_output=True, text=True, timeout=3, stdin=subprocess.DEVNULL)
        m = re.search(r"\d+\.\d+(?:\.\d+)?(?:[-+.\w]*)?", (r.stdout or r.stderr or ""))
        return m.group(0) if m else ""
    except Exception:
        return ""


def detect_agents():
    from concurrent.futures import ThreadPoolExecutor
    dirs = _search_dirs()
    live = {a.get("agent") for a in _load().values() if isinstance(a, dict)}
    try:
        settings = open(os.path.expanduser("~/.claude/settings.json")).read()
    except OSError:
        settings = ""

    def probe(row):
        aid, name, exes, cfgs, apps = row
        path = next((os.path.join(d, e) for e in exes for d in dirs
                     if os.access(os.path.join(d, e), os.X_OK) and not os.path.isdir(os.path.join(d, e))), "")
        app = next((a for a in apps if os.path.exists("/Applications/" + a)), "")
        used = any(os.path.exists(os.path.expanduser(c)) for c in cfgs)
        if app and not path and app.endswith("codex"):
            path = "/Applications/" + app          # bundled CLI inside another app
            app = ""
        installed = bool(path or app or used)     # a leftover config dir still means it was set up here
        connected = ("myzk-agents" in settings) if aid == "claude" else (aid in live)
        return {"id": aid, "name": name, "installed": installed, "path": path or ("/Applications/" + app if app else ""),
                "version": _version(path) if path else "", "used": used, "connected": connected and installed,
                "chat": bool(path) and (aid in ("claude", "codex") or _headless_cmd(aid) is not None),
                "models": discover_models(aid) if path else []}

    with ThreadPoolExecutor(max_workers=8) as ex:
        return list(ex.map(probe, KNOWN_AGENTS))


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "list"
    try:
        if cmd == "claude-hook":
            claude_hook()
        elif cmd == "mcp":
            mcp_server()
        elif cmd == "watch":
            watch()
        elif cmd == "ask" and len(args) >= 2:
            opts = dict(zip(args[2::2], args[3::2]))
            ask(args[1], opts.get("--resume"), opts.get("--id"), opts.get("--agent", "claude"), opts.get("--model"))
        elif cmd == "detect":
            print(json.dumps(detect_agents()))
        elif cmd == "route" and len(args) >= 2:   # dry run: which tier would the rules pick?
            tier, sig = classify_rules(args[1])
            print(json.dumps({"tier": tier, "signals": sig}, ensure_ascii=False))
        elif cmd == "router-stats":
            sys.stdout.write(router_stats())
        elif cmd == "list":
            sys.stdout.write(render())
        elif (cmd == "set" and len(args) >= 4) or (cmd == "rm" and len(args) >= 3):
            agent, ident = args[1], args[2]
            if cmd == "rm":
                update(agent, ident, remove=True)
            else:
                opts = dict(zip(args[4::2], args[5::2]))
                update(agent, ident, args[3],
                       name=opts.get("--name"), task=opts.get("--task"),
                       detail=opts.get("--detail"))
        else:
            print(__doc__)
            return 1
    except Exception as e:
        # A status board must never break the agent it is watching.
        if cmd == "claude-hook":
            return 0
        print(f"myzk-agents: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
